import tkinter as tk
from tkinter import ttk
import psutil
import platform
import time
from datetime import datetime

# Main window
root = tk.Tk()
root.title("System Performance Monitoring")
root.geometry("750x600")
root.configure(bg="#101820")

# Heading
title = tk.Label(
    root,
    text="SYSTEM PERFORMANCE MONITOR",
    font=("Arial", 20, "bold"),
    bg="#101820",
    fg="#00E5FF"
)
title.pack(pady=20)

# System information
system_label = tk.Label(
    root,
    text=f"Operating System: {platform.system()} | "
         f"Processor: {platform.processor() or 'Not available'}",
    font=("Arial", 10),
    bg="#101820",
    fg="white"
)
system_label.pack(pady=5)

# CPU display
cpu_label = tk.Label(
    root, text="CPU Usage: 0%",
    font=("Arial", 14, "bold"),
    bg="#101820", fg="white"
)
cpu_label.pack(pady=10)

cpu_bar = ttk.Progressbar(
    root, length=500, maximum=100, mode="determinate"
)
cpu_bar.pack()

# RAM display
ram_label = tk.Label(
    root, text="RAM Usage: 0%",
    font=("Arial", 14, "bold"),
    bg="#101820", fg="white"
)
ram_label.pack(pady=10)

ram_bar = ttk.Progressbar(
    root, length=500, maximum=100, mode="determinate"
)
ram_bar.pack()

# Disk display
disk_label = tk.Label(
    root, text="Disk Usage: 0%",
    font=("Arial", 14, "bold"),
    bg="#101820", fg="white"
)
disk_label.pack(pady=10)

disk_bar = ttk.Progressbar(
    root, length=500, maximum=100, mode="determinate"
)
disk_bar.pack()

# Battery display
battery_label = tk.Label(
    root, text="Battery: Checking...",
    font=("Arial", 12),
    bg="#101820", fg="#FFD166"
)
battery_label.pack(pady=15)

# Health status
status_label = tk.Label(
    root,
    text="System Status: Starting...",
    font=("Arial", 16, "bold"),
    bg="#101820",
    fg="#00FF88"
)
status_label.pack(pady=15)

# Last updated
time_label = tk.Label(
    root,
    text="",
    font=("Arial", 10),
    bg="#101820",
    fg="white"
)
time_label.pack(pady=5)


def update_monitor():

    # CPU usage
    cpu = psutil.cpu_percent(interval=None)
    cpu_bar["value"] = cpu
    cpu_label.config(text=f"CPU Usage: {cpu:.1f}%")

    # RAM usage
    ram = psutil.virtual_memory()
    ram_bar["value"] = ram.percent
    ram_label.config(
        text=f"RAM Usage: {ram.percent:.1f}% "
             f"({ram.used / (1024**3):.2f} GB used)"
    )

    # Disk usage
    disk = psutil.disk_usage("/")
    disk_bar["value"] = disk.percent
    disk_label.config(text=f"Disk Usage: {disk.percent:.1f}%")

    # Battery information
    battery = psutil.sensors_battery()

    if battery is not None:
        battery_label.config(
            text=f"Battery: {battery.percent:.0f}% | "
                 f"{'Charging' if battery.power_plugged else 'Not charging'}"
        )
    else:
        battery_label.config(
            text="Battery: Information unavailable"
        )

    # System health status
    if cpu >= 90 or ram.percent >= 90 or disk.percent >= 95:
        status_label.config(
            text="System Status: HIGH RESOURCE USAGE",
            fg="#FF5252"
        )
    elif cpu >= 75 or ram.percent >= 75 or disk.percent >= 85:
        status_label.config(
            text="System Status: WARNING",
            fg="#FFD166"
        )
    else:
        status_label.config(
            text="System Status: HEALTHY",
            fg="#00FF88"
        )

    # Current time
    time_label.config(
        text="Last Updated: " +
             datetime.now().strftime("%d-%m-%Y %H:%M:%S")
    )

    # Refresh every 2 seconds
    root.after(2000, update_monitor)


# Start monitoring
psutil.cpu_percent(interval=None)
update_monitor()

# Run application
root.mainloop()
